APP_NAME=AppiMeal
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=info

# Supabase Free PostgreSQL Configuration
DB_CONNECTION=pgsql
DB_HOST=db.your-supabase-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-supabase-ref
DB_PASSWORD=YourSupabaseDatabasePassword
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
